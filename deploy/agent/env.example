# Per-application environment for the backup agent.
# Copy to /etc/backwatch/<app>.env on each application server, e.g.
#   cp deploy/agent/env.example /etc/backwatch/talenta.env
# Adjust per server; never reuse an API key across applications.

APPLICATION=talenta
DATABASE_TYPE=postgresql

DB_HOST=localhost
DB_PORT=5432
DB_NAME=talenta
DB_USER=talenta
DB_PASSWORD=change-me

# Central API. Use the public HTTPS URL when the agent is not on the API host.
API_URL=http://localhost:8000
API_KEY=change-me

# local = files on the agent disk (MVP); s3 = S3-compatible object storage
# (MinIO, Ceph RGW, AWS S3, or rustfs exposing an S3 API).
STORAGE_DRIVER=local
STORAGE_BASE_DIR=/var/lib/backwatch
STORAGE_BUCKET=database-backups

# Required only when STORAGE_DRIVER=s3.
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_REGION=us-east-1

RETENTION_DAYS=30
TEMP_DIR=/var/tmp/backwatch