# Backup API (central server) production settings.
# Copy to .env before running deploy/api/install.sh:
#   cp deploy/api/.env.production.example .env.production

APP_NAME=Backup API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://backwatch:backwatch@postgres:5432/backwatch
CORS_ORIGINS=https://backup.example.com
ENABLE_METRICS=true

# REQUIRED: generate with `openssl rand -hex 32`
SECRET_KEY=replace-me-secret-key

# Alert notification channel (optional). Generic webhook accepting {"text": ...}.
# ALERT_WEBHOOK_URL=https://hooks.example.com/backwatch

# Watcher state location (persisted volume, set by docker-compose).
BACKWATCH_STATE_FILE=/var/backwatch/watcher-state.json