# --- Backup API ---
# PostgreSQL async connection string (metadata store)
DATABASE_URL=postgresql+asyncpg://backwatch:backwatch@localhost:5432/backwatch
# Secret used to sign/salt things like API keys
SECRET_KEY=change-me-in-production
# CORS origins (comma separated)
CORS_ORIGINS=*
# Enable Prometheus /metrics endpoint
ENABLE_METRICS=true

# --- Backup Agent ---
# Application identity reported to the API
APPLICATION=talenta
# Database type: postgresql or mysql
DATABASE_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talenta
DB_USER=talenta
DB_PASSWORD=change-me

# Storage: local (files on the agent disk) or s3 (S3-compatible object storage)
STORAGE_DRIVER=local
STORAGE_BASE_DIR=./backups
STORAGE_BUCKET=database-backups

# Required only when STORAGE_DRIVER=s3.
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_REGION=us-east-1

# Backup API endpoint + per-application API key
API_URL=http://localhost:8000
API_KEY=change-me

# Retention days
RETENTION_DAYS=30